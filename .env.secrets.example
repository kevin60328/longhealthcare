# 複製成 .env.secrets 後填入（.env.secrets 已被 .gitignore 排除，不會進版本控制）。
# 這個檔案只給本機腳本與測試使用（建立資料表、建立測試資料、RLS 測試）；
# Vite 不會讀它，所以這些秘密不會被打包進前端。

# Supabase 後台 → Project Settings → API Keys → service_role（secret）
SUPABASE_SERVICE_ROLE_KEY=

# Supabase 後台 → 上方「Connect」→ Session pooler 的連線字串，把 [YOUR-PASSWORD] 換成建立專案時設定的資料庫密碼
# 例：postgresql://postgres.abcdefgh:密碼@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# 測試帳號共用密碼（至少 8 個字元，自己定）
SEED_PASSWORD=

# 確認這是「測試專案」才設為 1；建立測試資料的腳本會拒絕寫入未標示的遠端專案
SEED_ALLOW_REMOTE=1
