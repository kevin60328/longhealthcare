{
  "name": "carelink-intake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "test:rls": "vitest run tests/rls",
    "db:seed": "node scripts/seed-test-data.mjs",
    "db:gen-seed": "node scripts/gen-seed-sql.mjs",
    "db:push": "node scripts/db-push.mjs",
    "visual:compare": "playwright test --config playwright.visual.config.js",
    "parity:gen": "playwright test --config playwright.parity.config.js",
    "db:seed-cases": "node scripts/seed-test-cases.mjs",
    "functions:sync": "node scripts/sync-functions.mjs",
    "functions:deploy": "npm run functions:sync && node scripts/deploy-functions.mjs",
    "db:clean-tests": "node scripts/clean-test-data.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2"
  }
}
